        {
          "name": "Upload URL for logo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/logo/upload-url/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workspaces",
                "{{workspaceId}}",
                "logo",
                "upload-url",
                ""
              ]
            },
            "description": "size is in BYTES and must equal the real file size exactly (check the file's properties, e.g. 4392), and content_type must match what you send in the PUT; both are part of the signature, otherwise R2 answers SignatureDoesNotMatch. Returns key and a signed upload_url. PUT the raw file bytes there (Body > binary) with the Content-Type header from the response and no other auth headers, then call Confirm logo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_type\": \"image/png\",\n  \"size\": 4392\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
