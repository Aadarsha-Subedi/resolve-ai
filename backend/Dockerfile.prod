# Production image: runtime dependencies only, non-root user, gunicorn.
FROM python:3.14-slim AS builder

ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=600 \
    UV_CONCURRENT_DOWNLOADS=4 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Docling's layout, table and OCR models are baked into the image: nothing is downloaded at runtime.
RUN /opt/venv/bin/docling-tools models download layout tableformer rapidocr -o /opt/docling-models


FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 1000 app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/docling-models /opt/docling-models
ENV DOCLING_ARTIFACTS_PATH=/opt/docling-models

WORKDIR /app
COPY --chown=app:app . .
USER app

EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--access-logfile", "-"]
