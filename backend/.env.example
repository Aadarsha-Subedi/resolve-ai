# Every variable below is required: settings.py fails at startup if one is missing.
# An empty value is allowed where noted.

# Database
RESOLVE_AI_DB_CONTAINER_NAME=resolveai-db
RESOLVE_AI_DB_NAME=
RESOLVE_AI_DB_USER=
RESOLVE_AI_DB_PASSWORD=
RESOLVE_AI_DB_HOST=localhost
RESOLVE_AI_DB_PORT=5432
RESOLVE_AI_DB_SSLMODE=disable
# Tests without Docker: use SQLite instead of Postgres (true/false)
RESOLVE_AI_USE_SQLITE=false

# Redis (cache, sessions, Celery broker)
RESOLVE_AI_REDIS_CONTAINER_NAME=resolveai-redis
RESOLVE_AI_REDIS_PORT=6379
RESOLVE_AI_REDIS_URL=redis://localhost:6379/0

# Django
RESOLVE_AI_SECRET_KEY=
RESOLVE_AI_DEBUG=true
RESOLVE_AI_ALLOWED_HOSTS=localhost,127.0.0.1
RESOLVE_AI_FRONTEND_URL=http://localhost:3000
RESOLVE_AI_CORS_ALLOWED_ORIGINS=http://localhost:3000
RESOLVE_AI_CSRF_TRUSTED_ORIGINS=http://localhost:3000
RESOLVE_AI_COOKIE_DOMAIN=
RESOLVE_AI_SECURE_COOKIES=false
RESOLVE_AI_SSL_REDIRECT=false
RESOLVE_AI_NUM_PROXIES=0

# Email (Django backend for system mail; Gmail API sending is a separate feature)
RESOLVE_AI_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESOLVE_AI_DEFAULT_FROM_EMAIL=no-reply@localhost

# Encryption keys for secrets at rest, comma separated (first encrypts, all decrypt). Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESOLVE_AI_ENCRYPTION_KEYS=

# File storage: Cloudflare R2. Leave the bucket empty to store files under media/.
RESOLVE_AI_R2_ENDPOINT_URL=
RESOLVE_AI_R2_ACCESS_KEY_ID=
RESOLVE_AI_R2_SECRET_ACCESS_KEY=
RESOLVE_AI_R2_BUCKET_NAME=
RESOLVE_AI_R2_PUBLIC_BASE_URL=

# Sentry (empty DSN disables it)
RESOLVE_AI_SENTRY_DSN=
# local or prod
RESOLVE_AI_ENVIRONMENT=local
# Local development only: relaxed throttle rates
RESOLVE_AI_RELAX_THROTTLES=false

# Google
RESOLVE_AI_GOOGLE_CLIENT_ID=
RESOLVE_AI_GOOGLE_CLIENT_SECRET=
RESOLVE_AI_PUBLIC_API_URL=

# Gmail push notifications through Google Pub/Sub (leave all three empty to disable push;
# the "Sync latest mails" button works without them).
# Topic: projects/<project-id>/topics/<topic>. Audience: the push endpoint URL configured on
# the subscription. Service account: the one the subscription uses to sign its JWT.
RESOLVE_AI_GMAIL_PUBSUB_TOPIC=
RESOLVE_AI_PUBSUB_PUSH_AUDIENCE=
RESOLVE_AI_PUBSUB_PUSH_SERVICE_ACCOUNT=