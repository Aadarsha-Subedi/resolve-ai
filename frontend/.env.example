# Where the Vite dev server proxies /api to (the Django backend).
# Running `pnpm dev` on your machine: the backend's published port on localhost.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional dev server settings.
# VITE_DEV_PORT=3000        # the backend's FRONTEND_URL, CORS and CSRF origins expect 3000
# VITE_USE_POLLING=true     # needed when files are bind-mounted on Docker Desktop

# Docker only (docker-compose.yml): where the container reaches the backend.
# "localhost" inside a container is the container itself, so this is not the value above.
# FRONTEND_API_PROXY_TARGET=http://host.docker.internal:8000
