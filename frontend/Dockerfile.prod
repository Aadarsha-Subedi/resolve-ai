# Production image: static build served by nginx, which also proxies /api to the backend.
FROM node:22-slim AS build

ENV CI=true
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM nginx:1.27-alpine

# nginx renders /etc/nginx/templates/*.template with the container's environment at start.
ENV API_UPSTREAM=http://host.docker.internal:8000
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
