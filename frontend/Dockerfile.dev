# Development image: Vite dev server with hot reload.
# docker-compose.yml bind-mounts the source over /app, so node_modules lives in a
# named volume (also at /app/node_modules) and the mount does not hide it.
FROM node:22-slim

ENV CI=true
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN chmod +x docker-entrypoint.dev.sh

EXPOSE 3000
# The entrypoint reinstalls dependencies when the lockfile changed (see docker-entrypoint.dev.sh).
ENTRYPOINT ["./docker-entrypoint.dev.sh"]
CMD ["pnpm", "dev"]
